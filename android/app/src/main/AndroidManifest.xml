<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Check-in's distance-from-office check only needs a coarse fix; requesting
         fine location too so FusedLocationProviderClient can return its best estimate
         on devices where only fine is actually available. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Phone-tracking subsystem (§8). PACKAGE_USAGE_STATS has no runtime dialog — it
         can only be granted from Settings (see tracking/collector/UsageAccess.kt) —
         which is what "ProtectedPermissions" below is acknowledging, not bypassing. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OfficeManagementApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneRoofTaskManager">

        <!-- WorkManager's own androidx-startup provider builds Workers with its
             default (no-arg-constructor) factory; removing it is what makes
             OfficeManagementApp's Configuration.Provider the one that actually takes
             effect, which is what lets CollectorWorker/SyncWorker take injected
             constructor dependencies at all. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OneRoofTaskManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the Reports screen share an exported CSV (a content:// URI, never a
             raw file:// path, which newer Android refuses to hand to another app) via
             a normal share-sheet intent instead of needing Storage Access Framework's
             heavier CreateDocument flow for this phase. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

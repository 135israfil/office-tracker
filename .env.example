# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Django checks the Origin header on unsafe requests against this list. In
# development the Vue dev server (:5173) is a different origin from the API
# (:8000), so without this every POST/PATCH/DELETE from the app is refused —
# login is the one exception, because DRF only enforces CSRF once a session
# exists. In production, set it to the origin the frontend is served from.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Only set this if the frontend and this API are on *different subdomains* of the same
# parent domain (e.g. frontend on app.example.com, this API on api.example.com) — leave
# it unset for same-origin deployments and for this local setup, where frontend and API
# share the literal hostname "localhost" regardless of port (cookies are not
# port-scoped, so nothing here needs widening). When it does apply: without this, the
# CSRF cookie defaults to the exact host that set it, so the frontend's own JavaScript
# can never read it back to echo in the X-CSRFToken header — no CORS or
# CSRF_TRUSTED_ORIGINS setting fixes that, because those govern the request, not what a
# *different* origin's JavaScript may read afterwards. Login still works either way
# (DRF only enforces CSRF once a session exists), so the symptom is every
# POST/PATCH/DELETE *after* logging in failing — looking exactly like a permissions bug.
# Set to the shared parent with a leading dot, e.g. .example.com.
DJANGO_CSRF_COOKIE_DOMAIN=
DJANGO_LOG_LEVEL=INFO

# Only read when DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true

# --- Database ---
POSTGRES_DB=office_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api

# Apache config for the built SPA (Vite copies this file into dist/ unchanged, so it
# ships with every build rather than needing to be copied onto the server by hand).
#
# Two problems this solves:
#
# 1. Vue Router uses HTML5 history mode (createWebHistory in src/router/index.js), so
#    a direct visit or refresh on a route like /settings or /reports is a request for a
#    path that has no matching file on disk. Without a rewrite, Apache 404s instead of
#    handing the request to index.html so Vue Router can resolve it client-side.
#
# 2. index.html references hashed asset filenames (e.g. assets/index-Da7LIPAw.js) that
#    change on every build. If index.html itself gets cached by the browser or an
#    upstream CDN, a fresh deploy can leave visitors served old HTML pointing at asset
#    files that no longer exist — the exact "my changes aren't showing up" symptom this
#    session spent a while chasing, just caused by caching instead of a stale build.
#    The hashed asset files are safe to cache hard, since a content change always means
#    a new filename; index.html is the one file that must never be cached.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories (the hashed assets, favicon, etc.) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route — hand it to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
